{
  "entities": {
    "Reservation": {
      "title": "Reservation",
      "description": "A table reservation entry",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Customer name" },
        "email": { "type": "string", "format": "email", "description": "Customer email" },
        "phone": { "type": "string", "description": "Customer phone" },
        "date": { "type": "string", "description": "ISO date string" },
        "time": { "type": "string", "description": "Time string" },
        "guests": { "type": "number", "description": "Number of guests" },
        "notes": { "type": "string", "description": "Special requests" },
        "userId": { "type": "string", "description": "Authenticated user ID or 'guest'" },
        "status": { 
          "type": "string", 
          "enum": ["pending", "confirmed", "cancelled"],
          "description": "Status of the reservation"
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" }
      },
      "required": ["name", "email", "phone", "date", "time", "guests", "status", "createdAt"]
    }
  },
  "firestore": {
    "/reservations/{reservationId}": {
      "schema": "Reservation",
      "description": "Collection of table reservations"
    }
  }
}
