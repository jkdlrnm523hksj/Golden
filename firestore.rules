rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "yulepop64@gmail.com" && request.auth.token.email_verified == true
      );
    }
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Reservation Validation ---
    function isValidReservation(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'date', 'time', 'guests', 'status', 'createdAt', 'userId'])
        && data.keys().size() >= 9 && data.keys().size() <= 10
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20
        && data.userId is string && data.userId.size() <= 128
        && data.date is string && data.date.size() == 10
        && data.time is string && data.time.size() <= 10
        && data.guests is int && data.guests >= 1 && data.guests <= 20
        && data.status in ['pending', 'confirmed', 'cancelled']
        && data.createdAt == request.time
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    // --- match blocks ---
    match /reservations/{reservationId} {
      allow create: if isValidId(reservationId) 
        && isValidReservation(incoming())
        && incoming().status == 'pending'; // Mandatory starting state
      
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow update: if (
        isAdmin() && isValidReservation(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        )
      ) || (
        isSignedIn() && existing().userId == request.auth.uid 
        && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        && incoming().status == 'cancelled'
        && existing().status == 'pending'
      );
        
      allow delete: if isAdmin();
    }
  }
}
